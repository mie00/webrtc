{
  "name": "webrtc-project",
  "version": "1.0.0",
  "description": "WebRTC-based project with TypeScript migration preparation",
  "main": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "electron:dev": "concurrently \"pnpm dev\" \"electron .\"",
    "electron:build": "electron-builder --publish=never",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "playwright test --grep-invert @slow",
    "test:e2e:ci": "playwright test --grep-invert @noci",
    "test:e2e:full": "playwright test",
    "test:unit": "vitest run",
    "test:unit:ui": "vitest --ui",
    "coverage": "vitest run --coverage --dir . --root src",
    "test": "pnpm test:unit",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "keywords": [
    "webrtc",
    "typescript",
    "testing",
    "svelte"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@mediapipe/selfie_segmentation": "^0.1.1675465747",
    "@playwright/test": "^1.49.1",
    "@sveltejs/adapter-static": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.8",
    "@tsconfig/svelte": "^5.0.4",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.5",
    "@types/socket.io-client": "^3.0.0",
    "@types/tesseract.js": "^0.0.2",
    "@types/webrtc": "^0.0.46",
    "@vitest/coverage-v8": "^3.1.4",
    "@vitest/ui": "^3.1.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "diff": "^7.0.0",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.3.0",
    "jimp": "^1.6.0",
    "jsdom": "^26.1.0",
    "mkdirp": "^3.0.1",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.4.0",
    "qrcode": "^1.5.4",
    "qrcode-reader": "^1.0.4",
    "rimraf": "^5.0.10",
    "socket.io-client": "^4.8.1",
    "svelte": "^5.28.2",
    "svelte-check": "^4.1.7",
    "svelte-preprocess": "^6.0.3",
    "tailwindcss": "^4.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "video-stream-merger": "^4.0.1",
    "vite": "^6.3.4",
    "vite-plugin-static-copy": "^3.0.0",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "tesseract.js": "^6.0.1"
  },
  "build": {
    "appId": "com.webrtcproject.app",
    "productName": "WebRTC Project App",
    "directories": {
      "output": "build_dir/app"
    },
    "files": [
      "electron-main.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
