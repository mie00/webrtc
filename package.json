{
  "name": "webrtc-project",
  "version": "1.0.0",
  "description": "WebRTC-based project with TypeScript migration preparation",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "serve": "lite-server",
    "start": "npm run build && npm run serve",
    "dev": "concurrently \"npm run watch\" \"npm run serve\"",
    "test": "node ./node_modules/.bin/jest",
    "test:watch": "node ./node_modules/.bin/jest --watch",
    "test:coverage": "node ./node_modules/.bin/jest --coverage",
    "test:unit": "node ./node_modules/.bin/jest __tests__/unit",
    "test:integration": "node ./node_modules/.bin/jest __tests__/integration"
  },
  "keywords": [
    "webrtc",
    "typescript",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.21.5",
    "@babel/preset-env": "^7.21.5",
    "@babel/preset-typescript": "^7.21.5",
    "@types/jest": "^26.0.24",
    "@types/webrtc": "^0.0.40",
    "babel-jest": "^26.6.3",
    "concurrently": "^8.0.1",
    "jest": "^26.6.3",
    "jest-environment-jsdom-sixteen": "^1.0.3",
    "lite-server": "^2.6.1",
    "ts-jest": "^26.5.6",
    "typescript": "^4.9.5"
  }
}
