{
  "name": "webrtc-project",
  "version": "1.0.0",
  "description": "WebRTC-based project with TypeScript migration preparation",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --enable-source-maps\" jest",
    "test:watch": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --enable-source-maps\" jest --watch",
    "test:coverage": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --enable-source-maps\" jest --coverage",
    "test:unit": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --enable-source-maps\" jest __tests__/unit",
    "test:integration": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --enable-source-maps\" jest __tests__/integration",
    "test:e2e": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --enable-source-maps\" jest --config jest-puppeteer.config.cjs --rootDir . --runInBand __tests__/e2e",
    "test:cur": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --enable-source-maps\" jest --config jest-puppeteer.config.cjs --rootDir . --runInBand __tests__/e2e/link-client-connection.test.ts"
  },
  "keywords": [
    "webrtc",
    "typescript",
    "testing",
    "svelte"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "svelte": "^5.28.2"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@sveltejs/adapter-static": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.7",
    "@tsconfig/svelte": "^5.0.4",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/puppeteer": "^5.4.7",
    "@types/socket.io-client": "^3.0.0",
    "@types/webrtc": "^0.0.46",
    "babel-jest": "^29.7.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "fs-extra": "^11.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-puppeteer": "^11.0.0",
    "jimp": "^1.6.0",
    "mkdirp": "^3.0.1",
    "puppeteer": "^24.8.0",
    "qrcode-reader": "^1.0.4",
    "rimraf": "^5.0.10",
    "svelte-check": "^4.1.7",
    "svelte-jester": "^5.0.0",
    "svelte-preprocess": "^6.0.3",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.4"
  }
}
