{
  "compilerOptions": {
    "target": "es2018",
    "module": "esnext",
    "moduleResolution": "node",
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "baseUrl": ".",
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "outDir": "./dist",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "js/**/*.ts",
    "js/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
